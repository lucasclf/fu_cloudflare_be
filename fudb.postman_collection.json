{
    "info": {
        "name": "FUDB — Fábula Última Database",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        { "key": "baseUrl", "value": "http://localhost:8787", "type": "string" },
        { "key": "adminToken", "value": "", "type": "string", "description": "Bearer token do arquivo .dev.vars (API_TOKEN)" },
        { "key": "userToken", "value": "", "type": "string", "description": "JWT gerado automaticamente pelo endpoint de login" }
    ],
    "item": [

        {
            "name": "🔐 Autenticação",
            "item": [
                {
                    "name": "Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    const body = pm.response.json();",
                                    "    pm.collectionVariables.set('userToken', body.data.token);",
                                    "    console.log('userToken salvo com sucesso');",
                                    "} else {",
                                    "    console.warn('Login falhou. Token não atualizado.');",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"admin@exemplo.com\",\n    \"password\": \"sua_senha_aqui\"\n}",
                            "options": { "raw": { "language": "json" } }
                        },
                        "url": {
                            "raw": "{{baseUrl}}/v1/auth/login",
                            "host": ["{{baseUrl}}"],
                            "path": ["v1", "auth", "login"]
                        }
                    }
                }
            ]
        },

